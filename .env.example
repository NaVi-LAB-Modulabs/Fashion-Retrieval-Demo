OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_DESCRIPTION_VECTOR_INDEX=item_description_embedding_filtered

# Reuse successful parsing, embeddings and web search results across local restarts.
FASHION_CACHE_ENABLED=1
# 0 keeps entries until eviction or a revision change (4096 entries per cache layer).
FASHION_CACHE_TTL_SECONDS=0
FASHION_CACHE_MAX_ENTRIES=4096
# Optional absolute path to a writable persistent SQLite file.
# FASHION_CACHE_PATH=C:\Users\jiyoo\GithubRepo\Fashion-Retrieval-Demo\.cache\retrieval.sqlite3
# Bump after changing graph data, stored embeddings, or the HNSW index.
FASHION_DATASET_REVISION=1
# exact scans all model-compatible, hard-filtered vectors; hnsw is faster but approximate.
FASHION_VECTOR_SEARCH_MODE=exact

# Optional: defaults already point to the public Fashion200K dataset.
HF_IMAGE_DATASET=Marqo/fashion200k
HF_IMAGE_CONFIG=default
HF_IMAGE_SPLIT=data
HF_IMAGE_ID_COLUMN=item_ID
# HF_TOKEN=your_hugging_face_read_token
